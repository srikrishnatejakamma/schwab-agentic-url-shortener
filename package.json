{
  "name": "schwab-agentic-url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "yarn build",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario:greenfield": "tsx src/scenarios/runScenario.ts greenfield",
    "scenario:brownfield": "tsx src/scenarios/runScenario.ts brownfield",
    "scenario:ambiguous": "tsx src/scenarios/runScenario.ts ambiguous"
  },
  "dependencies": {
    "express": "^5.1.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}